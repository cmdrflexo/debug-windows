#pragma kernel ClearHistogram
#pragma kernel BuildHistogram
#pragma kernel ComputeExposure

#define HISTOGRAM_BIN_COUNT 256

Texture2D<float> _MeteringTexture;
RWStructuredBuffer<uint> _Histogram;
RWStructuredBuffer<float> _ExposureState;

int _MeteringWidth;
int _MeteringHeight;
float _HistogramMinimumLog;
float _HistogramMaximumLog;
float _LowPercent;
float _HighPercent;
float _MiddleGray;
float _Compensation;
float _MinimumExposure;
float _MaximumExposure;
float _BrightenSpeed;
float _DarkenSpeed;
float _DeltaTime;

[numthreads(HISTOGRAM_BIN_COUNT, 1, 1)]
void ClearHistogram(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    _Histogram[dispatchThreadId.x] =
        0;
}

[numthreads(8, 8, 1)]
void BuildHistogram(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x >= _MeteringWidth ||
        dispatchThreadId.y >= _MeteringHeight)
    {
        return;
    }

    float luminance =
        _MeteringTexture.Load(
            int3(
                dispatchThreadId.xy,
                0));

    if (!(luminance > 0.000001) ||
        luminance > 1.0e20)
    {
        return;
    }

    float logLuminance =
        log2(luminance);
    float histogramPosition =
        saturate(
            (logLuminance -
                _HistogramMinimumLog) /
            max(
                _HistogramMaximumLog -
                    _HistogramMinimumLog,
                0.0001));
    uint histogramIndex =
        min(
            (uint)(histogramPosition *
                HISTOGRAM_BIN_COUNT),
            HISTOGRAM_BIN_COUNT -
                1);

    InterlockedAdd(
        _Histogram[histogramIndex],
        1);
}

[numthreads(1, 1, 1)]
void ComputeExposure(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint totalSampleCount =
        0;

    for (uint index = 0;
        index < HISTOGRAM_BIN_COUNT;
        index++)
    {
        totalSampleCount +=
            _Histogram[index];
    }

    bool uninitialized =
        _ExposureState[3] <
        0.0;
    float targetExposure =
        _MaximumExposure;
    float averageLogLuminance =
        _HistogramMinimumLog;

    if (totalSampleCount > 0)
    {
        float lowCut =
            totalSampleCount *
            saturate(_LowPercent);
        float highCut =
            totalSampleCount *
            saturate(_HighPercent);
        float cumulativeCount =
            0.0;
        float includedCount =
            0.0;
        float weightedLogLuminance =
            0.0;

        for (uint index = 0;
            index < HISTOGRAM_BIN_COUNT;
            index++)
        {
            float binCount =
                _Histogram[index];
            float nextCumulativeCount =
                cumulativeCount +
                binCount;
            float acceptedCount =
                max(
                    0.0,
                    min(
                        nextCumulativeCount,
                        highCut) -
                    max(
                        cumulativeCount,
                        lowCut));
            float binPosition =
                (index + 0.5) /
                HISTOGRAM_BIN_COUNT;
            float binLogLuminance =
                lerp(
                    _HistogramMinimumLog,
                    _HistogramMaximumLog,
                    binPosition);

            weightedLogLuminance +=
                binLogLuminance *
                acceptedCount;
            includedCount +=
                acceptedCount;
            cumulativeCount =
                nextCumulativeCount;
        }

        if (includedCount > 0.0)
        {
            averageLogLuminance =
                weightedLogLuminance /
                includedCount;
            targetExposure =
                log2(
                    max(
                        _MiddleGray,
                        0.0001)) -
                averageLogLuminance +
                _Compensation;
        }
    }

    targetExposure =
        clamp(
            targetExposure,
            _MinimumExposure,
            _MaximumExposure);

    float currentExposure =
        uninitialized
            ? targetExposure
            : _ExposureState[0];
    float adaptationSpeed =
        targetExposure >
            currentExposure
            ? _BrightenSpeed
            : _DarkenSpeed;
    float adaptationBlend =
        1.0 -
        exp(
            -max(
                adaptationSpeed,
                0.0) *
            max(
                _DeltaTime,
                0.0));
    currentExposure =
        lerp(
            currentExposure,
            targetExposure,
            adaptationBlend);

    _ExposureState[0] =
        currentExposure;
    _ExposureState[1] =
        targetExposure;
    _ExposureState[2] =
        averageLogLuminance;
    _ExposureState[3] =
        totalSampleCount;
}
